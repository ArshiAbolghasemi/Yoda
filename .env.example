# ---------------------------------------------------------------------------
# Dataset pipeline (yoda.data)
# ---------------------------------------------------------------------------
# Alpaca paper-trading endpoint. Historical news uses the Alpaca data endpoint.
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2
APCA_API_KEY_ID=your_alpaca_key_id
APCA_API_SECRET_KEY=your_alpaca_secret_key

# Optional overrides; omitted values use defaults from yoda/data/settings.py.
# DATA__MARKET__START=2017-01-01
# DATA__MARKET__END=2026-09-18
# DATA__MARKET__BITCOIN='["BTC-USD"]'
# DATA__MARKET__FX='["EURUSD=X", "GBPUSD=X", "USDJPY=X"]'
# DATA__MARKET__EQUITIES='["AAPL", "MSFT"]'
# DATA__DOWNLOAD__WORKERS=4
# DATA__TARGETS__HORIZONS='[1, 5, 10, 20]'
# DATA__STORAGE__ROOT=data
# DATA__STORAGE__RAW_MARKET=raw/market
# DATA__STORAGE__RAW_NEWS=raw/news
# DATA__STORAGE__PROCESSED=processed
# DATA__STORAGE__FINAL_FILENAME=financial_dataset.parquet
# DATA__DATASET__DROP_INCOMPLETE_TARGETS=false
# DATA__NEWS__MARKET_TIMEZONE=America/New_York
# DATA__NEWS__MARKET_CLOSE_HOUR=16
# DATA__NEWS__SEPARATOR=' || '

# ---------------------------------------------------------------------------
# Walk-forward splits and scoring intervals (must be contiguous, increasing)
# ---------------------------------------------------------------------------
SPLIT__TRAIN_START=2017-01-01
SPLIT__TRAIN_END=2022-12-31
SPLIT__VAL_START=2023-01-01
SPLIT__VAL_END=2023-12-31
SPLIT__TEST_START=2024-01-01
SPLIT__TEST_END=2026-09-18
# 0 = a single fold. >0 = rolling refit every N test rows, expanding history.
# SPLIT__REFIT_DAYS=0

# Named regime windows scored separately by yoda.evaluation.
EVAL__INTERVALS=[{name="covid",start=2020-02-01,end=2020-05-31},{name="bear_2022",start=2022-01-01,end=2022-10-31}]
EVAL__ROLLING_WINDOWS=[20,60]
# EVAL__PERIODS_PER_YEAR=252
# EVAL__PLOTS=true

# ---------------------------------------------------------------------------
# Panel alignment
# ---------------------------------------------------------------------------
# PANEL__DATASET=                      # blank => auto-resolve under the data root
# PANEL__CALENDAR=equity               # equity (NYSE) | intersection | union
# PANEL__MAX_FORWARD_FILL=5
# PANEL__TARGET_HORIZON=1              # which future_return_Nd trains specialists
# PANEL__MIN_HISTORY=250               # per-asset indicator warm-up
# PANEL__REALIZED_VOL_WINDOWS=[5,20,60]

# ---------------------------------------------------------------------------
# Specialists
# ---------------------------------------------------------------------------
# SPECIALISTS__Z_DIM=8
# SPECIALISTS__RIDGE_ALPHA=10.0
# SPECIALISTS__SEED=7

# ---------------------------------------------------------------------------
# OpenJev specialists. Headlines, technical and volatility features all reach
# the portfolio through the locally served decision model.
#
# Serve it first:  cd llm-serve && ./serve.sh      (or: docker compose up -d)
# ---------------------------------------------------------------------------
NEWS__BACKEND=jev                      # jev | none
# JEV__SYNTHETIC=false                 # true = deterministic fakes, CI only

# API root - the SDK appends /v1/systemone itself, so no trailing /v1.
JEV__BASE_URL=http://127.0.0.1:3000
JEV__API_KEY=                          # the shim's SHIM_TOKEN, if you set one
# JEV__MODEL=                          # pin a version; empty records what the shim reports
# JEV__PROMPT_VERSION=v1               # part of the cache key
# JEV__MAX_CONCURRENCY=8
# JEV__TIMEOUT=120
# JEV__CACHE=processed/jev

# The CIO agent: one decision sets both the gate and the risk stance.
# CIO__PROMPT_VERSION=v1
# CIO__CACHE=processed/cio
# CIO__LEVELS=5

# --- llm-serve/ : how OpenJev itself is served -------------------------------
# Read by llm-serve/serve.sh and llm-serve/docker-compose.yml.
# HF_TOKEN=                            # only if the repo is gated for you
# MODEL_REPO=openjev/openjev
# MODEL_DIR=./openjev
# SERVE_HOST=127.0.0.1
# SERVED_NAME=qwen
# VLLM_PORT=8000
# SHIM_PORT=3000
# GPU_COUNT=1
# GPU_MEMORY_UTILIZATION=0.90
# SHIM_TOKEN=
# Published readout calibration - refitting is required if you change these.
# READOUT_T=0.85
# READOUT_NOUL_T=1.829074
# READOUT_NOUL_BIAS=0
# READOUT_TARGETED=1
# READOUT_INSTR_STYLE=pyrepr
# SHIM_STAGGER=1

# ---------------------------------------------------------------------------
# Copula (joint tail model)
# ---------------------------------------------------------------------------
# COPULA__MARGINALS=empirical
# COPULA__SHRINKAGE=0.1
# COPULA__NU_GRID=[3,4,5,6,8,10,15,20,30]
# COPULA__N_SCENARIOS=2000
# COPULA__VOL_HALFLIFE=60
# COPULA__CORR_WINDOW=250
# COPULA__CORR_BLEND=0.5
# COPULA__SEED=11

# ---------------------------------------------------------------------------
# DRO-CVaR optimizer. ALPHA is a fixed hyperparameter, never an RL action.
# ---------------------------------------------------------------------------
# OPT__ALPHA=0.05
# OPT__DRO=wasserstein                 # wasserstein | moment | none
# OPT__RADIUS=0.001
# OPT__BUDGET_MODE=constraint          # constraint | penalty
# OPT__BUDGET_PENALTY=50.0
# OPT__MAX_WEIGHT=0.25
# OPT__SOLVER=CLARABEL

# ---------------------------------------------------------------------------
# Tail-VoI gate and its counterfactual targets
# ---------------------------------------------------------------------------
# TAILVOI__SOURCES=["technical","volatility","news"]
# TAILVOI__TEMPERATURE=1.0
# TAILVOI__MODE=softmax                # softmax | threshold
# TAILVOI__THRESHOLD=0.0
# TAILVOI__HIDDEN=[32]
# TAILVOI__N_STATES=250
# TAILVOI__COUNTERFACTUAL_SCENARIOS=500
# TAILVOI__RHO=realized                # realized | reference
# TAILVOI__RHO_WINDOW=60
# TAILVOI__SEED=13

# ---------------------------------------------------------------------------
# Static pipeline (tail_voli_risk): the risk policy
# ---------------------------------------------------------------------------
# STATIC_POLICY__LAM=1.0
# STATIC_POLICY__BUDGET=0.05
# STATIC_POLICY__TURNOVER_PENALTY=0.001
# STATIC_POLICY__VOL_TARGET=0.0        # >0 enables the vol-target schedule

# ---------------------------------------------------------------------------
# RL pipeline (tail_voli_risk_rl): SAC risk controller.
# REWARD_LAMBDA_CVAR is the FIXED reward-shaping weight - not the lam the policy
# chooses for the optimizer objective. Keep the two distinct.
# ---------------------------------------------------------------------------
# RL__TOTAL_TIMESTEPS=5000             # each step is a convex solve
# RL__ENV_SCENARIOS=500
# RL__LEARNING_RATE=0.0003
# RL__BATCH_SIZE=256
# RL__BUFFER_SIZE=50000
# RL__LEARNING_STARTS=500
# RL__SEED=17
# RL__SYNTHETIC_EPISODES=0             # copula-generated episodes appended
# RL__LAM_BOUNDS=[0.1,10.0]
# RL__BUDGET_BOUNDS=[0.01,0.20]
# RL__TURNOVER_BOUNDS=[0.0,0.01]
# RL__REWARD_LAMBDA_CVAR=1.0
# RL__REWARD_LAMBDA_DD=0.5
# RL__REWARD_TURNOVER_COST=0.001
# RL__CHECKPOINT=processed/rl/sac_risk_policy

# ---------------------------------------------------------------------------
# Backtest execution
# ---------------------------------------------------------------------------
# BACKTEST__REBALANCE_DAYS=5
# BACKTEST__COST_BPS=5.0
# BACKTEST__RUNS=processed/runs
# BACKTEST__SEED=23
